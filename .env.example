# Copy to .env before running migrations:  cp .env.example .env
#
# SQLite lives in a file next to the schema, so there is nothing to install or
# start. The path is relative to prisma/, not to the repo root.
DATABASE_URL="file:./dev.db"

# Mocked auth — there is no identity provider in this project (see lib/auth.ts).
# Change this to exercise the authorization boundary in the UI:
#   ADMIN    full access, including recruiter-only internal notes
#   REVIEWER can review; internal notes are stripped server-side
#   VIEWER   read-only; the review form renders in its unauthorized state
DEMO_USER_ROLE="REVIEWER"
